[Unit]
Description=Hermes OmniRoute AI Router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment="HOME=/home/ubuntu"
Environment="PATH=/usr/local/nvm/versions/node/v22.23.2/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PORT=20129"
ExecStart=/usr/local/bin/omniroute serve --port 20129 --no-open --no-tray
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
